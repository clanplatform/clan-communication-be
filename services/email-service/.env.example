SERVICE_NAME=email-service
VERSION=1.0.0
DEBUG=false
PORT=8001

DATABASE_URL=postgresql+asyncpg://postgres:root@postgres:5432/emails
REDIS_URL=redis://redis:6379/0

# ── SMTP relay (primary when enabled) ─────────────────────────────────────────
# Works with Gmail, Outlook, Mailgun, or any corporate SMTP server.
# Gmail: use an App Password (Google Account → Security → 2-Step Verification
# → App passwords) as SMTP_PASSWORD, with SMTP_USERNAME = your Gmail address.
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ── SendGrid (primary) ────────────────────────────────────────────────────────
# Sign up free at https://sendgrid.com → Settings → API Keys → Create API Key
# Free tier: 100 emails/day forever
SENDGRID_ENABLED=true
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Default sender identity (used by all providers) ──────────────────────────
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Clan Platform

# ── AWS SES (optional second fallback) ───────────────────────────────────────
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_ENABLED=false

# ── Internal services ─────────────────────────────────────────────────────────
NOTIFICATION_SERVICE_URL=http://notification-service:8000
