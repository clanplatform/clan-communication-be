# Local development environment
ENVIRONMENT=local
DEBUG=true

# PostgreSQL (single shared instance for local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=clan
POSTGRES_PASSWORD=clan_dev_password
POSTGRES_DB=clan_comms

# Per-service databases
NOTIFICATION_DB_URL=postgresql+asyncpg://clan:clan_dev_password@localhost:5432/notifications
EMAIL_DB_URL=postgresql+asyncpg://clan:clan_dev_password@localhost:5432/emails
SMS_DB_URL=postgresql+asyncpg://clan:clan_dev_password@localhost:5432/sms
PUSH_DB_URL=postgresql+asyncpg://clan:clan_dev_password@localhost:5432/push
IN_APP_DB_URL=postgresql+asyncpg://clan:clan_dev_password@localhost:5432/in_app
WHATSAPP_DB_URL=postgresql+asyncpg://clan:clan_dev_password@localhost:5432/whatsapp

# Redis
REDIS_URL=redis://localhost:6379/0

# Service ports
NOTIFICATION_SERVICE_PORT=8000
EMAIL_SERVICE_PORT=8001
SMS_SERVICE_PORT=8002
PUSH_SERVICE_PORT=8003
IN_APP_SERVICE_PORT=8004
WHATSAPP_SERVICE_PORT=8005
WEBSOCKET_SERVICE_PORT=8006
WHATSAPP_WEBJS_PORT=3000

# Secrets (use dev values locally)
SECRET_KEY=local-dev-secret-key-do-not-use-in-prod
