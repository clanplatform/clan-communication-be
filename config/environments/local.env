# Local development environment
ENVIRONMENT=local
DEBUG=true

# PostgreSQL (single shared instance for local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5411
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=postgres

# Per-service databases
NOTIFICATION_DB_URL=postgresql+asyncpg://postgres:root@localhost:5411/notifications
EMAIL_DB_URL=postgresql+asyncpg://postgres:root@localhost:5411/emails
SMS_DB_URL=postgresql+asyncpg://postgres:root@localhost:5411/sms
PUSH_DB_URL=postgresql+asyncpg://postgres:root@localhost:5411/push
IN_APP_DB_URL=postgresql+asyncpg://postgres:root@localhost:5411/in_app
WHATSAPP_DB_URL=postgresql+asyncpg://postgres:root@localhost:5411/whatsapp

# Redis
REDIS_URL=redis://localhost:6379/0

# Postal — self-hosted mail server (primary email provider when enabled)
POSTAL_ENABLED=false
POSTAL_URL=http://localhost:5000
POSTAL_API_KEY=

# Service ports
NOTIFICATION_SERVICE_PORT=8000
EMAIL_SERVICE_PORT=8001
SMS_SERVICE_PORT=8002
PUSH_SERVICE_PORT=8003
IN_APP_SERVICE_PORT=8004
WHATSAPP_SERVICE_PORT=8005
WEBSOCKET_SERVICE_PORT=8006
WHATSAPP_WEBJS_PORT=3000

# Secrets (use dev values locally)
SECRET_KEY=local-dev-secret-key-do-not-use-in-prod
