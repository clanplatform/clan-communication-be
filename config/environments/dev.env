# Development / staging environment
ENVIRONMENT=dev
DEBUG=false

POSTGRES_HOST=dev-postgres.internal
POSTGRES_PORT=5432
POSTGRES_USER=clan
POSTGRES_PASSWORD=REPLACE_WITH_DEV_PASSWORD

REDIS_URL=redis://dev-redis.internal:6379/0

SECRET_KEY=REPLACE_WITH_DEV_SECRET_KEY

# SMTP relay (primary email provider when enabled)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Email sender identity (used by all providers)
SMTP_FROM_EMAIL=dev@clan-platform.com

# SMS
TWILIO_ACCOUNT_SID=REPLACE
TWILIO_AUTH_TOKEN=REPLACE
TWILIO_FROM_NUMBER=+15551234567
