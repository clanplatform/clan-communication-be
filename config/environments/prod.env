# Production environment — all values must come from secrets manager (Vault/AWS SM)
ENVIRONMENT=prod
DEBUG=false

# These should be injected by your secrets manager at runtime
POSTGRES_HOST=${PROD_POSTGRES_HOST}
POSTGRES_PORT=5432
POSTGRES_USER=${PROD_POSTGRES_USER}
POSTGRES_PASSWORD=${PROD_POSTGRES_PASSWORD}

REDIS_URL=${PROD_REDIS_URL}

SECRET_KEY=${PROD_SECRET_KEY}

SMTP_FROM_EMAIL=clan.platform@gmail.com
SMTP_FROM_NAME=Clan Platform

SENDGRID_API_KEY=${PROD_SENDGRID_API_KEY}
SENDGRID_ENABLED=true

TWILIO_ACCOUNT_SID=${PROD_TWILIO_SID}
TWILIO_AUTH_TOKEN=${PROD_TWILIO_TOKEN}
TWILIO_FROM_NUMBER=${PROD_TWILIO_FROM}

FCM_SERVER_KEY=${PROD_FCM_SERVER_KEY}
FCM_PROJECT_ID=${PROD_FCM_PROJECT_ID}

META_WA_TOKEN=${PROD_META_WA_TOKEN}
META_WA_PHONE_ID=${PROD_META_WA_PHONE_ID}
META_WA_ENABLED=true
